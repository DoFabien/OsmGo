{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "i18n",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/i18n/**"]
      }
    },
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/*.mjs",
          "/manifest.webmanifest",
          "/media/**"
        ]
      },
      "cacheQueryOptions": {
        "ignoreVary": true,
        "ignoreSearch": true
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "map-tiles-previously-viewed",
      "urls": [
        "https://tiles.openfreemap.org/planet/**",
        "https://data.geopf.fr/tms/1.0.0/ORTHOIMAGERY.ORTHOPHOTOS/**",
        "https://ecn.t0.tiles.virtualearth.net/**",
        "https://ecn.t1.tiles.virtualearth.net/**",
        "https://ecn.t2.tiles.virtualearth.net/**",
        "https://ecn.t3.tiles.virtualearth.net/**"
      ],
      "cacheConfig": {
        "maxSize": 800,
        "maxAge": "15d",
        "strategy": "performance"
      }
    },
    {
      "name": "basemap-tilejson",
      "urls": ["https://tiles.openfreemap.org/planet"],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "30d",
        "timeout": "3s",
        "strategy": "freshness"
      }
    }
  ]
}
