{
  "name": "osm_go",
  "author": "Fabien Del Olmo",
  "description": "Map them all !",
  "homepage": "https://github.com/DoFabien/OsmGo",
  "version": "2.0.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "scripts": {
    "ng": "ng",
    "config": "tsx --tsconfig ./scripts/tsconfig.json ./src/environments/set-env.ts",
    "start": "npm run config PWA &&  ng serve --host 0.0.0.0",
    "build": "npm run config PWA &&  ng build --configuration production",
    "buildAndroid": "npm run android:release",
    "buildAndroidDebug": "npm run config Android && ng build --configuration development && node scripts/neutralizeNativeServiceWorker.mjs && npx cap sync android",
    "android:prepare": "npm run config Android && ng build --configuration production && node scripts/neutralizeNativeServiceWorker.mjs && npx cap sync android",
    "android:apk": "npm run android:prepare && ./android/gradlew -p android --no-daemon assembleRelease",
    "android:aab": "npm run android:prepare && ./android/gradlew -p android --no-daemon bundleRelease",
    "android:release": "npm run android:prepare && ./android/gradlew -p android --no-daemon clean testReleaseUnitTest lintRelease assembleRelease bundleRelease",
    "android:studio": "npx cap open android",
    "android:version-code": "node scripts/android-version-code.mjs",
    "test": "npm run config && ng test --watch=false && ng test --configuration browser",
    "test:coverage": "npm run config && ng test --watch=false --coverage && ng test --configuration browser",
    "test:ci": "npm run config && ng test --configuration ci --coverage && ng test --configuration browser",
    "i18n": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/i18n.ts",
    "test:converter": "tsx scripts/osmToOsmgo/test.js",
    "test:sprites": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/generateSprites.test.ts",
    "test:scripts": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/_fetch.test.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/basemap-utils.test.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/nameSuggestionIndex.test.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/validateGeneratedCatalog.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/presets.test.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/svgFormat.test.ts && node scripts/materialSymbols.test.mjs",
    "icons:subset": "node scripts/subsetMaterialSymbols.mjs",
    "basemap:style": "node scripts/buildBasemapStyle.mjs",
    "catalog:validate": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/validateGeneratedCatalog.ts",
    "test:integration": "playwright test",
    "test:integration:install": "playwright install chromium",
    "pwa:validate": "npm run build && npm run pwa:validate:built",
    "pwa:validate:built": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/validatePwaBuild.ts",
    "check": "biome check . --diagnostic-level=error",
    "sprites": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/importMissingSVGs.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/formatSVG.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/sprites.ts",
    "importFromID": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/importTagsFromID.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/ordersTags.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/importDeprecatdeTagsFromiD.ts && tsx --tsconfig ./scripts/tsconfig.json ./scripts/addTranslationFromiD.ts",
    "importBaseMaps": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/importBasemaps.ts",
    "importDescriptions": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/importDescriptionFromTaginfo.ts --overwrite",
    "cleanTagsPresets": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/cleanTags.ts",
    "presets:generate": "npm run importFromID && npm run cleanTagsPresets && tsx --tsconfig ./scripts/tsconfig.json ./scripts/importBrands.ts && npm run catalog:validate",
    "update": "npm run presets:generate && npm run sprites && npm run importBaseMaps",
    "prepare": "husky install",
    "prettier:check": "prettier --check \"**/*.{html,scss,md,yaml,yml}\"",
    "prettier:write": "prettier --write \"**/*.{html,scss,md,yaml,yml}\""
  },
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-browser-dynamic": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/service-worker": "22.2.5",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@turf/area": "7.3.5",
    "@turf/bbox-polygon": "7.3.5",
    "@turf/boolean-point-in-polygon": "7.3.5",
    "@turf/destination": "7.3.5",
    "@turf/helpers": "7.3.5",
    "@turf/length": "7.3.5",
    "@turf/point-on-feature": "7.3.5",
    "fast-xml-parser": "5.10.1",
    "localforage": "1.10.0",
    "maplibre-gl": "6.17.0",
    "martinez-polygon-clipping": "0.8.1",
    "material-symbols": "0.45.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.6",
    "@capacitor/cli": "8.6.0",
    "@mapbox/sphericalmercator": "^1.2.0",
    "@mapbox/tile-cover": "^3.0.2",
    "@openstreetmap/id-tagging-schema": "7.3.0",
    "@playwright/test": "1.62.1",
    "@turf/centroid": "7.3.5",
    "@types/fs-extra": "^11.0.1",
    "@types/geojson": "^7946.0.10",
    "@types/node": "^24.13.3",
    "@types/svgo": "^3.0.0",
    "@types/xml2js": "^0.4.11",
    "@types/yargs": "^17.0.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cheerio": "^1.0.0-rc.3",
    "fontkit": "2.0.4",
    "fs-extra": "^11.1.1",
    "http-server": "14.1.1",
    "husky": "^8.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "json-stringify-pretty-compact": "^2.0.0",
    "lint-staged": "17.3.0",
    "name-suggestion-index": "8.0.20261101",
    "parse-svg-path": "^0.1.2",
    "prettier": "3.9.6",
    "scale-svg-path": "0.0.1",
    "serialize-svg-path": "^0.1.0",
    "sharp": "0.35.3",
    "subset-font": "2.9.0",
    "svgo": "3.3.4",
    "tsx": "4.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.0.8",
    "xml2js": "^0.6.2",
    "yargs": "^17.5.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --diagnostic-level=error",
    "*.{html,scss,md,yaml,yml}": "prettier --write"
  }
}
